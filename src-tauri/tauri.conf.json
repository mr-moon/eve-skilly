{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skilly",
  "version": "0.12.6",
  "identifier": "app.skilly.planner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skilly — Skill Planner",
        "width": 1440,
        "height": 920,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#111315"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://images.evetech.net; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "EVE Online skill planner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Russian"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
